APP_NAME="Fashion Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fashion_store
DB_USERNAME=fashion_store
DB_PASSWORD=fashion_store
DB_ROOT_PASSWORD=root
DB_FORWARD_PORT=3307

APP_FORWARD_PORT=8080
VITE_FORWARD_PORT=5173
MAILPIT_FORWARD_PORT=8025
MINIO_FORWARD_PORT=9000
MINIO_CONSOLE_FORWARD_PORT=9001
STORE_SHIPPING_FEE=30000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO (S3-compatible, chạy trong compose.yaml) — production trỏ sang S3
# thật bằng cách đổi AWS_ENDPOINT/AWS_URL, không cần đổi code.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=fashion-store
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/fashion-store
AWS_USE_PATH_STYLE_ENDPOINT=true

VIETQR_BUSINESS_CACHE_SECONDS=900
VIETQR_BUSINESS_REQUESTS_PER_MINUTE=10

# AI agent hỗ trợ đăng sản phẩm (widget chat trong trang admin).
# AI_SELF_HOST_ENDPOINT: dán nguyên base URL nhà cung cấp đưa (thường có sẵn
# "/v1" ở cuối, vd http://host:port/v1) — code chỉ nối thêm "/chat/completions".
# AI_SELF_HOST_ENDPOINT/KEY/MODEL và AI_MAX_TOKENS chỉ là giá trị MẶC ĐỊNH
# ban đầu — sau khi admin lưu cấu hình tại /admin/cai-dat/ai (bảng
# ai_settings), giá trị đã lưu trong DB sẽ được ưu tiên dùng thay cho các
# biến này (xem App\Services\Ai\AiSettings).
AI_REQUESTS_PER_MINUTE=6
AI_MAX_IMAGE_KB=4096
AI_MAX_HISTORY_MESSAGES=24
AI_MAX_TOKENS=3072
# Trợ lý gợi ý sản phẩm cho khách hàng (storefront, không cần đăng nhập).
AI_SHOPPING_REQUESTS_PER_MINUTE=15
AI_SHOPPING_MAX_HISTORY_MESSAGES=20
AI_SELF_HOST_ENDPOINT=
AI_SELF_HOST_KEY=
AI_SELF_HOST_MODEL=

VITE_APP_NAME="${APP_NAME}"
